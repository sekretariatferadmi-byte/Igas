# ========================================
# IGAS Configuration Template
# ========================================
# Copy this file ke .env dan isi dengan data Anda
# cp config/.env.example .env

# ========================================
# Instagram Configuration
# ========================================
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_ID=optional_session_id
INSTAGRAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)...

# ========================================
# Proxy Configuration (Optional)
# ========================================
USE_PROXY=false
PROXY_LIST=proxies.txt
PROXY_TYPE=http  # http, socks4, socks5
PROXY_ROTATION=true

# ========================================
# Database Configuration
# ========================================
# SQLite (Default)
DATABASE_URL=sqlite:///data.db

# PostgreSQL (Alternative)
# DATABASE_URL=postgresql://user:password@localhost:5432/igas_db

# MongoDB (For NoSQL)
# MONGODB_URL=mongodb://localhost:27017/igas

# ========================================
# API Configuration
# ========================================
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=true
API_KEY=your_secret_api_key
JWT_SECRET=your_jwt_secret_key

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/igas.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ========================================
# Application Settings
# ========================================
APP_NAME=IGAS
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, production, testing
DEBUG=true
SECRET_KEY=your_app_secret_key

# ========================================
# Timeout & Retry Configuration
# ========================================
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY=5

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# ========================================
# Email Configuration (Optional)
# ========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@igas.com

# ========================================
# Webhook Configuration (Optional)
# ========================================
WEBHOOK_URL=http://localhost:5000/webhook
WEBHOOK_SECRET=your_webhook_secret

# ========================================
# External APIs (Optional)
# ========================================
GITHUB_TOKEN=your_github_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# ========================================
# Termux Specific Settings
# ========================================
TERMUX_NOTIFICATION_ENABLED=true
TERMUX_STORAGE_PATH=/storage/emulated/0
TERMUX_PREFIX=/data/data/com.termux/files/usr

# ========================================
# Feature Flags
# ========================================
FEATURE_AUTO_POSTING=true
FEATURE_BOT_MODE=true
FEATURE_SCRAPING=true
FEATURE_SCHEDULING=true

# ========================================
# Performance Settings
# ========================================
ASYNC_WORKERS=4
THREAD_POOL_SIZE=10
CONNECTION_POOL_SIZE=20

# ========================================
# Security Settings
# ========================================
ALLOW_ORIGINS=*
CORS_ENABLED=true
SSL_VERIFY=true
MAX_REQUEST_SIZE=10485760  # 10MB
